# ── TESTIFAI backend keys ─────────────────────────────────────────────────────

# Anthropic (Claude) — required. Get at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Open States — optional. Get at openstates.org/accounts/profile/
# Adds STATE legislature members (state senate + house). Without it, the app
# still serves U.S. Senators + U.S. Representatives for every state.
OPENSTATES_API_KEY=
